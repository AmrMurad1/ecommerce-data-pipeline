# Airflow Configuration
AIRFLOW_UID=1000
AIRFLOW__CORE__FERNET_KEY=<generate-with-python-cryptography.fernet.Fernet.generate_key()>
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.2
AIRFLOW_PROJ_DIR=.

# PostgreSQL Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Optional: Additional pip packages
_PIP_ADDITIONAL_REQUIREMENTS=pandas sqlalchemy psycopg2-binary openpyxl requests
